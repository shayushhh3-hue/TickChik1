rules_version = '2';
// תיק צ׳יק – who may read and write what. Mirrors the access rules the page had as a claude.ai artifact:
//   the owner's documents are the owner's alone; prices, history/prices and research are readable by every invited
//   person; each invited person keeps their own data under data/users/<uid>/ and their watch list under watch/<uid>;
//   the bot user (the scheduled jobs and the price refresh) writes prices, history, alerts state and research.
// Before pasting into Firebase: put your own addresses in the two lines below.
service cloud.firestore {
  match /databases/{database}/documents {
    function ownerEmail() { return "owner@example.com"; }   // <-- the owner's Google address, lowercase
    function botEmail()   { return "bot@example.com"; }     // <-- the bot user (Authentication › Users)

    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function email() { return request.auth.token.email.lower(); }
    function isOwner() { return signedIn() && email() == ownerEmail() && request.auth.token.email_verified == true; }
    function isBot() { return signedIn() && email() == botEmail(); }
    function invited() { return isOwner() || (signedIn() && request.auth.token.email_verified == true && exists(/databases/$(database)/documents/invites/$(email()))); }
    function self(uid) { return invited() && request.auth.uid == uid; }

    // the invite list: the owner manages it; a person may read their own entry
    match /invites/{em} {
      allow read: if isOwner() || (signedIn() && em == email());
      allow write: if isOwner();
    }
    // the owner's portfolio, plan and settings
    match /portfolio/{doc} { allow read: if isOwner() || isBot(); allow write: if isOwner(); }
    match /plan/{doc}      { allow read, write: if isOwner(); }
    match /settings/{doc}  { allow read: if isOwner() || isBot(); allow write: if isOwner(); }
    // history: the owner's, with the monthly closes readable by everyone invited; the jobs add points and rows
    match /history/{doc} {
      allow read: if isOwner() || isBot() || (doc == 'prices' && invited());
      allow write: if isOwner() || isBot();
    }
    match /reports/{document=**} { allow read, write: if isOwner() || isBot(); }
    match /alerts/{doc} { allow read, write: if isOwner() || isBot(); }
    // shared market data
    match /quotes/{doc}   { allow read: if invited(); allow write: if isOwner() || isBot(); }
    match /research/{doc} { allow read: if invited(); allow write: if isOwner() || isBot(); }
    // each person's watch list (symbols only); the jobs read them to know which prices to fetch
    match /watch/{uid} {
      allow read: if isOwner() || isBot() || self(uid);
      allow write: if isOwner() || self(uid);
    }
    // each invited person's private documents
    match /data/users/{uid}/{document=**} { allow read, write: if self(uid); }
  }
}
